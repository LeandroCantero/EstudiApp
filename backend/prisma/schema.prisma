generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model Career {
  id          String          @id @default(uuid())
  name        String          @unique
  institute   String?
  duration    Float?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  subjects    CareerSubject[]
  userCareers UserCareer[]
}

model Subject {
  id        String          @id @default(uuid())
  name      String          @unique
  hours     Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  careers   CareerSubject[]
}

model CareerSubject {
  id              String           @id @default(uuid())
  code            String
  year            Int?
  period          Int?
  careerId        String
  subjectId       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  career          Career           @relation(fields: [careerId], references: [id], onDelete: Cascade)
  subject         Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studentSubjects StudentSubject[]
  prerequisites   CareerSubject[]  @relation("CareerSubjectCorrelatives")
  requiredBy      CareerSubject[]  @relation("CareerSubjectCorrelatives")

  @@unique([careerId, subjectId])
  @@unique([careerId, code])
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String
  password        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  credits         Credit[]
  events          Event[]
  globalResources GlobalResource[] @relation("CreatedBy")
  subjects        StudentSubject[]
  userCareers     UserCareer[]
  resources       UserResource[]
}

model UserCareer {
  id            String   @id @default(uuid())
  userId        String
  careerId      String
  approvedCount Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  career        Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, careerId])
}

model StudentSubject {
  id              String        @id @default(uuid())
  userId          String
  careerSubjectId String
  status          SubjectStatus @default(PENDIENTE)
  courseGrade     Float?
  finalGrade      Float?
  attemptCount    Int           @default(1)
  completionYear  Int?
  completionPeriod Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  events          Event[]
  exams           Exam[]
  careerSubject   CareerSubject @relation(fields: [careerSubjectId], references: [id])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes           SubjectNote[]

  @@unique([userId, careerSubjectId])
}

model SubjectNote {
  id               String         @id @default(uuid())
  studentSubjectId String
  title            String?
  content          String?
  url              String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  studentSubject   StudentSubject @relation(fields: [studentSubjectId], references: [id], onDelete: Cascade)
}

model Exam {
  id               String         @id @default(uuid())
  studentSubjectId String
  type             String
  date             DateTime?
  grade            Float?
  maxGrade         Float          @default(10)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  eventId          String?        @unique
  calendarEvent    Event?         @relation(fields: [eventId], references: [id])
  studentSubject   StudentSubject @relation(fields: [studentSubjectId], references: [id], onDelete: Cascade)
}

model Credit {
  id        String   @id @default(uuid())
  userId    String
  category  String
  activity  String
  credits   Int
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id               String          @id @default(uuid())
  userId           String
  studentSubjectId String?
  title            String
  type             String
  date             DateTime
  description      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  studentSubject   StudentSubject? @relation(fields: [studentSubjectId], references: [id])
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam             Exam?
}

model GlobalResource {
  id          String   @id @default(uuid())
  category    String
  title       String
  url         String
  description String?
  createdById String?
  isDefault   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("CreatedBy", fields: [createdById], references: [id])
}

model UserResource {
  id          String   @id @default(uuid())
  userId      String
  category    String
  title       String
  url         String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SubjectStatus {
  PENDIENTE
  EN_CURSO
  REGULARIZADA
  PROMOCIONADA
  DESAPROBADA
  RECURSANDO
}
