generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model Career {
  id        String    @id @default(uuid())
  name      String    @unique
  institute String?   // Instituto (ej: "Tecnología e Ingeniería")
  duration  Float?    // Duración en años
  subjects  CareerSubject[] // Materias vinculadas a esta carrera
}

model Subject {
  id        String   @id @default(uuid())
  name      String   @unique // Ej: "Matemática I"
  hours     Int      @default(0) // Horas totales globales
  
  careers   CareerSubject[] // Dónde se dicta esta materia
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CareerSubject {
  id        String   @id @default(uuid())
  code      String   // Código específico en el plan (ej: I101)
  year      Int?     // Año en que se dicta en ESTA carrera
  period    Int?     // Cuatrimestre en que se dicta en ESTA carrera
  
  careerId  String
  career    Career   @relation(fields: [careerId], references: [id])

  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])

  // Correlatividades (Self-relation en el contexto de la carrera)
  prerequisites CareerSubject[] @relation("CareerSubjectCorrelatives")
  requiredBy    CareerSubject[] @relation("CareerSubjectCorrelatives")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([careerId, subjectId]) // Una materia no puede estar dos veces en la misma carrera con distintos códigos
}
